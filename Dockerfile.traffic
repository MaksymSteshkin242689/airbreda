# airbreda-traffic — NDW traffic ingestion for the four A27 sites. One run = one feed snapshot;
# scheduled every 5 minutes by cron on the VM.
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

COPY requirements-ingest.txt .
RUN pip install --no-cache-dir -r requirements-ingest.txt

COPY src/settings.py src/observability.py src/db.py src/migrate.py src/sites.py src/ingest_traffic.py ./
COPY db/migrations db/migrations

RUN useradd --create-home --uid 1000 app
USER app

CMD ["python", "ingest_traffic.py"]
