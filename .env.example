# Copy to .env and fill in. .env is git-ignored.
DB_HOST=your-rds-endpoint.eu-north-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=airbreda
DB_USER=airbreda
DB_PASSWORD=change-me
S3_BUCKET=airbreda-<your-name>-raw
AWS_REGION=eu-north-1
# DB_SSLMODE=require   # default; set to disable only for a local non-TLS Postgres
# Local dev only (on the VM the instance role provides credentials):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
